PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string_here
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_string

# Optional — for real password-reset emails. If left blank, the backend
# automatically uses a free Ethereal test inbox and logs a preview link
# to the terminal instead, so password reset still works without any setup.
# Example for Gmail: create an "app password" in your Google Account
# security settings (not your normal password), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your_16_character_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Life's Potion Apothecary" <no-reply@lifespotion.local>
